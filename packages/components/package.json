{
  "name": "@tenilla/components",
  "version": "0.0.1",
  "description": "Common components for Tenilla",
  "description_zh": "Tenilla 的常用组件",
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./Modal": {
      "types": "./dist/Modal/Modal.d.mts",
      "import": "./dist/Modal/Modal.mjs",
      "default": "./dist/Modal/Modal.mjs"
    },
    "./Modal.css": "./dist/Modal/Modal.css",
    "./Pagination": {
      "types": "./dist/Pagination/Pagination.d.mts",
      "import": "./dist/Pagination/Pagination.mjs",
      "default": "./dist/Pagination/Pagination.mjs"
    },
    "./Pagination.css": "./dist/Pagination/Pagination.css",
    "./Tooltip": {
      "types": "./dist/Tooltip/Tooltip.d.mts",
      "import": "./dist/Tooltip/Tooltip.mjs",
      "default": "./dist/Tooltip/Tooltip.mjs"
    },
    "./Tooltip.css": "./dist/Tooltip/Tooltip.css",
    "./SmartForm": {
      "types": "./dist/SmartForm/SmartForm.d.mts",
      "import": "./dist/SmartForm/SmartForm.mjs",
      "default": "./dist/SmartForm/SmartForm.mjs"
    },
    "./SmartForm.css": "./dist/SmartForm/SmartForm.css",
    "./TabPanel": {
      "types": "./dist/TabPanel/TabPanel.d.mts",
      "import": "./dist/TabPanel/TabPanel.mjs",
      "default": "./dist/TabPanel/TabPanel.mjs"
    },
    "./TabPanel.css": "./dist/TabPanel/TabPanel.css"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "dom",
    "dom-manipulation",
    "framework",
    "web"
  ],
  "license": "MIT",
  "author": {
    "name": "Kasukabe Tsumugi",
    "email": "futami16237@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/baendlorel/tenilla",
    "directory": "packages/components"
  },
  "peerDependencies": {
    "@tenilla/core": "workspace:^*"
  },
  "scripts": {
    "build": "tsdown"
  }
}