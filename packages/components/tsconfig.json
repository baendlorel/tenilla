{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "types": ["node", "../../types/client.d.ts"],
    "paths": {
      "@tenilla/core": ["../core/src/index.ts"]
    }
  },
  "include": ["./src/**/*"]
}
