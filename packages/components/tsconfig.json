{
  "compilerOptions": {
    "composite": true,
    "module": "NodeNext",
    "moduleResolution": "nodenext",
    "rootDir": "./src",
    "outDir": "./dist",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "stripInternal": true,
    "types": ["node", "vite/client"],
    "paths": {
      "@tenilla/core": ["../core/src/index.ts"]
    }
  },
  "include": ["./src/**/*"],
  "references": [{ "path": "../core" }]
}
