{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "../../types/client.d.ts", "../core/dist/index.d.mts"],
    "paths": {
      "@tenilla/core": ["../core/src/index.ts"],
      "@tenilla/components/DatePicker": ["../components/src/DatePicker/DatePicker.ts"],
      "@tenilla/components/DateTimePicker": ["../components/src/DateTimePicker/DateTimePicker.ts"],
      "@tenilla/components/Grid": ["../components/src/Grid/Grid.ts"],
      "@tenilla/components/Modal": ["../components/src/Modal/Modal.ts"],
      "@tenilla/components/Pagination": ["../components/src/Pagination/Pagination.ts"],
      "@tenilla/components/SmartForm": ["../components/src/SmartForm/SmartForm.ts"],
      "@tenilla/components/StringInput": ["../components/src/StringInput/StringInput.ts"],
      "@tenilla/components/NumberInput": ["../components/src/NumberInput/NumberInput.ts"],
      "@tenilla/components/TextArea": ["../components/src/TextArea/TextArea.ts"],
      "@tenilla/components/BooleanInput": ["../components/src/BooleanInput/BooleanInput.ts"],
      "@tenilla/components/Select": ["../components/src/Select/Select.ts"],
      "@tenilla/components/CheckboxGroup": ["../components/src/CheckboxGroup/CheckboxGroup.ts"],
      "@tenilla/components/RadioGroup": ["../components/src/RadioGroup/RadioGroup.ts"],
      "@tenilla/components/TabPanel": ["../components/src/TabPanel/TabPanel.ts"],
      "@tenilla/components/TimePicker": ["../components/src/TimePicker/TimePicker.ts"],
      "@tenilla/components/Tooltip": ["../components/src/Tooltip/Tooltip.ts"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts"]
}
